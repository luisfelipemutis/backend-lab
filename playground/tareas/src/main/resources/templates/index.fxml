<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="478.0" prefWidth="681.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fm.tareas.controller.IndexController">
    <children>
        <Label layoutX="235.0" layoutY="14.0" text="Sistema de Tareas" textFill="#e63946">
            <font>
                <Font name="System Bold" size="25.0"/>
            </font>
        </Label>
        <TableView fx:id="tareaTable" layoutX="250.0" layoutY="63.0" onMouseClicked="#loadTareaForm" prefHeight="289.0"
                   prefWidth="419.0">
            <columns>
                <TableColumn fx:id="idTareaColumn" prefWidth="40.0" text="ID"/>
                <TableColumn fx:id="nombreTareaColumn" prefWidth="163.0" text="Tarea"/>
                <TableColumn fx:id="responsableColumn" minWidth="0.0" prefWidth="116.0" text="Responsable"/>
                <TableColumn fx:id="estatusColumn" prefWidth="98.0" text="Estatus"/>
            </columns>
        </TableView>
        <AnchorPane layoutX="24.0" layoutY="76.0" prefHeight="276.0" prefWidth="219.0">
            <children>
                <Label layoutX="23.0" layoutY="10.0" prefHeight="28.0" prefWidth="123.0" text="Tarea"
                       textFill="#457b9d">
                    <font>
                        <Font name="System Bold" size="19.0"/>
                    </font>
                </Label>
                <Label layoutX="23.0" layoutY="98.0" prefHeight="28.0" prefWidth="123.0" text="Responsable"
                       textFill="#457b9d">
                    <font>
                        <Font name="System Bold" size="19.0"/>
                    </font>
                </Label>
                <Label layoutX="23.0" layoutY="187.0" prefHeight="28.0" prefWidth="123.0" text="Estatus"
                       textFill="#457b9d">
                    <font>
                        <Font name="System Bold" size="19.0"/>
                    </font>
                </Label>
                <TextField fx:id="nombreTareaField" layoutX="22.0" layoutY="41.0" prefHeight="36.0" prefWidth="149.0"/>
                <TextField fx:id="responsableField" layoutX="22.0" layoutY="127.0" prefHeight="36.0" prefWidth="149.0"/>
                <TextField fx:id="estatusField" layoutX="22.0" layoutY="215.0" prefHeight="40.0" prefWidth="149.0"/>
            </children>
        </AnchorPane>
        <AnchorPane layoutX="23.0" layoutY="361.0" prefHeight="116.0" prefWidth="636.0" AnchorPane.bottomAnchor="6.0"
                    AnchorPane.leftAnchor="23.0" AnchorPane.rightAnchor="22.0" AnchorPane.topAnchor="361.0">
            <children>
                <Button fx:id="agregarBtn" alignment="CENTER" layoutX="14.0" layoutY="38.0" mnemonicParsing="false"
                        onAction="#saveTarea" prefHeight="40.0" prefWidth="114.0" style="-fx-background-color: #1d3557;"
                        text="Agregar" textFill="#f1faee" AnchorPane.bottomAnchor="38.0" AnchorPane.leftAnchor="14.0"
                        AnchorPane.rightAnchor="505.0" AnchorPane.topAnchor="38.0">
                    <font>
                        <Font size="19.0"/>
                    </font>
                </Button>
                <Button fx:id="modificarBtn" alignment="CENTER" layoutX="151.0" layoutY="38.0" mnemonicParsing="false"
                        onAction="#updateTarea" prefHeight="40.0" prefWidth="123.0"
                        style="-fx-background-color: #1d3557;" text="Modificar" textFill="#f1faee"
                        AnchorPane.bottomAnchor="38.0" AnchorPane.leftAnchor="151.0" AnchorPane.rightAnchor="359.0"
                        AnchorPane.topAnchor="38.0">
                    <font>
                        <Font size="19.0"/>
                    </font>
                </Button>
                <Button fx:id="eliminarBtn" alignment="CENTER" layoutX="298.0" layoutY="38.0" mnemonicParsing="false"
                        onAction="#deleteTarea" prefHeight="40.0" prefWidth="114.0"
                        style="-fx-background-color: #e63946;" text="Eliminar" textFill="#f1faee"
                        AnchorPane.bottomAnchor="38.0" AnchorPane.rightAnchor="221.0" AnchorPane.topAnchor="38.0">
                    <font>
                        <Font size="19.0"/>
                    </font>
                </Button>
                <Button fx:id="limpiarBtn" alignment="CENTER" layoutX="435.0" layoutY="38.0" mnemonicParsing="false"
                        onAction="#cleanForm" style="-fx-background-color: #ffd60a;" text="Limpiar Formulario"
                        AnchorPane.bottomAnchor="38.0" AnchorPane.topAnchor="38.0">
                    <font>
                        <Font size="19.0"/>
                    </font>
                </Button>
            </children>
        </AnchorPane>
    </children>
    <opaqueInsets>
        <Insets/>
    </opaqueInsets>
</AnchorPane>
